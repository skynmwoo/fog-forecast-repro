# --- data -------------------------------------------------------------
# Raw KMA ASOS files are NOT redistributed (see README "Data" section).
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- large or regenerable artefacts ------------------------------------
# Trained models and per-row predictions are fully regenerated by
# scripts/run_experiments.py in a few minutes, so they are not committed.
# Everything needed to verify the PAPER's numbers lives in results/metrics/,
# which IS committed.
checkpoints/**
!checkpoints/.gitkeep
results/logs/*.npy
*.pkl
*.joblib
*.pt
*.pth

# --- python ------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- os / editor -------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*~
*.swp

# --- never commit ------------------------------------------------------
.env
*.key
*.pem
secrets*
